{
  "name": "auto-compress-tool",
  "version": "1.0.0",
  "description": "本地批量 7z 压缩工具：密码记忆、AES-256 文件名加密、自动分卷（至少两卷）、完整性测试",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "author": "local",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "desktop:dev": "npm run build && electron .",
    "desktop:build": "npm run build && electron-builder --win",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:desktop": "npm run build && electron test/desktop-smoke.cjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.10.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "eslint": "^9.39.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.0"
  }
}
